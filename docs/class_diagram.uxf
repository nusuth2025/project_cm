<?xml version="1.0" encoding="UTF-8"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>

  <!-- ============================================================ -->
  <!-- MODELS                                                        -->
  <!-- ============================================================ -->

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>10</x><y>10</y><w>230</w><h>120</h></coordinates>
    <panel_attributes>User
--
+id: int
+username: string
+email: string
+passwordHash: string
+createdAt: DateTimeImmutable
--
+fromRow(row): self</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>10</x><y>160</y><w>240</w><h>220</h></coordinates>
    <panel_attributes>MonitoredPage
--
+id: int
+userId: int
+url: string
+selectionText: ?string
+innerSelectionText: ?string
+label: ?string
+status: string
+checkIntervalMinutes: int
+startHour: int
+lastCheckedAt: ?DateTime
+checkCount: int
+createdAt: DateTimeImmutable
+updatedAt: DateTimeImmutable
--
+fromRow(row): self</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>10</x><y>410</y><w>240</w><h>170</h></coordinates>
    <panel_attributes>MonitoringDump
--
+id: int
+monitoredPageId: int
+htmlContent: string
+checkedContent: ?string
+foundAt: DateTimeImmutable
+changed: bool
+changeNote: string
+previousCheckedContent: ?string
--
+fromRow(row): self</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>10</x><y>610</y><w>200</w><h>80</h></coordinates>
    <panel_attributes>DB
&lt;&lt;Singleton&gt;&gt;
--
-instance: ?PDO
--
+getInstance(): PDO</panel_attributes>
    <additional_attributes/>
  </element>

  <!-- ============================================================ -->
  <!-- SERVICES                                                       -->
  <!-- ============================================================ -->

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>10</y><w>240</w><h>230</h></coordinates>
    <panel_attributes>SessionService
--
--
+ensureSessionId(): void
+getSessionId(): ?string
+setUrl(url): void
+getUrl(): ?string
+setSelection(sel): void
+getSelection(): ?string
+setInnerSelection(s): void
+getInnerSelection(): ?string
+setUserId(id): void
+getUserId(): ?int
+isLoggedIn(): bool
+clearMonitorFlow(): void
+reset(): void</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>270</y><w>240</w><h>70</h></coordinates>
    <panel_attributes>UrlCheckService
--
--
+check(url): UrlCheckResult</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>370</y><w>240</w><h>110</h></coordinates>
    <panel_attributes>UrlCheckResult
&lt;&lt;final&gt;&gt;
--
+isUsable: bool
+statusCode: int
+effectiveUrl: string
+message: string
+severity: string
--
+wasRedirected(url): bool</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>510</y><w>240</w><h>110</h></coordinates>
    <panel_attributes>SelectionSearchService
--
--
+tokenize(selection): array
+findPositions(html, sel): array
+findMissingWord(html, sel): ?array
+buildHighlightedHtml(...): string</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>650</y><w>240</w><h>110</h></coordinates>
    <panel_attributes>MonitoringService
--
--
+fetchHtml(url): string
+runCheck(page): MonitoringDump
+getPreviousDump(id): ?MonitoringDump
+hasChanged(prev, curr): bool</panel_attributes>
    <additional_attributes/>
  </element>

  <element>
    <type>com.umlet.element.Class</type>
    <coordinates><x>290</x><y>790</y><w>240</w><h>70</h></coordinates>
    <panel_attributes>NotificationService
--
--
+sendChangedNotifications(changes): void</panel_attributes>
    <additional_attributes/>
  </element>

