    <type>com.umlet.element.Relation</type>
    <coordinates><x>720</x><y>90</y><w>45</w><h>20</h></coordinates>
    <panel_attributes>lt=&lt;.</panel_attributes>
    <additional_attributes>45;10;0;10</additional_attributes>
  </element>

