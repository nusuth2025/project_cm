    <type>com.umlet.element.Relation</type>
    <coordinates><x>215</x><y>40</y><w>50</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>0;10;50;10</additional_attributes>
  </element>

  <!-- app/ (router) → Controller -->
