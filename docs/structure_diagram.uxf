    <type>com.umlet.element.Relation</type>
    <coordinates><x>445</x><y>40</y><w>320</w><h>20</h></coordinates>
    <panel_attributes>lt=-&gt;</panel_attributes>
    <additional_attributes>0;10;320;10</additional_attributes>
  </element>

  <!-- Controller → Service -->
